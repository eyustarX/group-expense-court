# ====================================================================
# Group Expense Court - Environment Configuration Template
# ====================================================================

# Neon Serverless Postgres Connection String (HTTP pooled connection)
# Example: postgresql://court_user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/court_db?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS Configuration (for Amazon Textract and Amazon Bedrock)
AWS_REGION=us-east-1
# Bedrock Foundation Model ID (e.g. anthropic.claude-3-haiku-20240307-v1:0 or amazon.nova-micro-v1:0)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Backend CORS Allowed Origin (defaults to * if not set)
FRONTEND_ORIGIN=http://localhost:5173

# Frontend API URL (for local dev or deployed Lambda HTTP API Gateway)
# In development, Vite can proxy /api or use this directly
VITE_API_URL=http://localhost:3001

